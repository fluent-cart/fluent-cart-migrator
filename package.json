{
  "name": "fluent-cart-migrator",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "pot": "wp i18n make-pot . languages/fluent-cart-migrator.pot --domain=fluent-cart-migrator --ignore-domain --exclude=assets/js,node_modules,vendor --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/fluent-cart/fluent-cart-migrator/issues\"}'",
    "i18n": "npm run build && npm run pot"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^6.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "vue": "^3.4.0"
  }
}
